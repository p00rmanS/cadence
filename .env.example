# Copy to .env and fill in only what you actually have configured.
# ShiftFit works fully without any of these set: local text parsing, manual
# scheduling, auto-fill, and localStorage persistence all work with zero config.
# NEVER commit a real .env file (.gitignore blocks it) and never put a secret in a VITE_ variable.

# ---- Website (safe to be public: bundled into the site's JavaScript) ----
# Address of the ShiftFit server (the Netlify Functions at /api/...). Use "/" when the
# functions run on the same site as the app, or the full address (https://your-site.netlify.app)
# when the app is on GitHub Pages. Leave empty to run fully local: text
# parsing always works, screenshot reading is off, and "Send to Google Calendar"
# only does a practice run that never claims a real sync happened.
VITE_AUTOMATION_API_URL=

# ---- Server only (NOT used now: the team deploys to GitHub Pages, which can't run servers) ----
# For whichever host runs src/server/ later (the netlify/functions/ wrappers fit Netlify).
# The servers stay switched off (answer "503 not set up") until these are set.
#
# Passcode managers type to sign in before sending to Google Calendar or reading screenshots. 12+ characters.
MANAGER_PASSCODE=
# Address of the n8n server, https only (http is allowed only for localhost while testing).
AUTOMATION_URL=
# Password the n8n webhooks require (n8n Header Auth credential: Name "Authorization", Value "Bearer <this>"). 16+ random characters.
AUTOMATION_SECRET=
# Password n8n uses to call the scheduler service at /api/scheduler/*. 16+ random characters.
SCHEDULER_SECRET=
# Only when the website is hosted somewhere else than the server (GitHub Pages): that website's
# address, so browsers may call the gateway from it. Comma-separated for several. Never "*".
ALLOWED_ORIGINS=

# ---- Build only ----
# The folder the site lives in. GitHub Pages serves this project from /cadence/; the deploy
# workflow sets this for you. Leave empty everywhere else.
BASE_PATH=
