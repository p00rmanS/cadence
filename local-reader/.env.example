# Copy this file to ".env" (same folder) and paste your Claude API key after the = sign.
# ".env" is ignored by Git, so the key never goes to GitHub. Never put it in a VITE_ variable.
ANTHROPIC_API_KEY=

# A passcode you invent (12+ characters). Type it into Cadence's manager sign-in box to use the reader.
READER_PASSCODE=
